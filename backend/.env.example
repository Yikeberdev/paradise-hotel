# Server Port
PORT=5000

# Authentication (16+ chars recommended)
JWT_SECRET=paradise_hotel_secret_2024_secure_key

# Database Option 1: Full Connection URL (Recommended for Railway, Render, Supabase, Aiven)
# DATABASE_URL=mysql://user:password@host:port/database_name

# Database Option 2: Individual variables
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=paradise_hotel
# Set to true if your cloud database requires SSL (e.g. PlanetScale, Aiven, Railway)
DB_SSL=false

# CORS & Frontend URLs (comma-separated or wildcard '*')
